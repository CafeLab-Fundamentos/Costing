# Plantilla — copiar a .env y rellenar.
# spring-dotenv resuelve estos valores en application.properties.

# Credenciales Supabase (DB_USERNAME = "postgres" o "postgres.<ref>")
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-password>
SUPABASE_PROJECT_REF=<your-project-ref>

# URL del microservicio Management para el ACL de Production (validar coffeeLotId).
# En Azure App Service, configurar esta variable apuntando al Web App de Management:
#   https://cafelab-management-h3csf4dzb0h5h8d0.canadacentral-01.azurewebsites.net
MANAGEMENT_SERVICE_URL=http://localhost:8080
