# Plantilla — copiar a .env y rellenar.
# spring-dotenv resuelve estos valores en application.properties.

# Credenciales Supabase (DB_USERNAME = "postgres" o "postgres.<ref>")
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-password>
SUPABASE_PROJECT_REF=<your-project-ref>

# JWT (debe ser identico al del monolito para validar tokens emitidos por IAM)
JWT_SECRET=CafeLabLocalDevSecretKey2026MinimumLength32Chars

# URL del monolito para el ACL de Production (coffeeLotId ownership)
MONOLITH_BASE_URL=http://localhost:8080
